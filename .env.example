# ============================================================
# AutoCare Insight — Environment Configuration Template
# Copy this file to .env.local and fill in your local credentials
# ============================================================

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=autocare_insight
MYSQL_CONNECTION_LIMIT=10
# Set true for a hosted MySQL service that requires TLS. Certificate and hostname verification remain enabled.
MYSQL_SSL=false
# Optional PEM CA certificate if the host uses a private CA; otherwise use Node's trusted roots.
# MYSQL_SSL_CA=

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/autocare_db
MONGODB_DB_NAME=autocare_db

# Authentication / Security
# Generate a unique value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production rejects missing, short and known example signing keys.
JWT_SECRET=

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="AutoCare Insight"
NEXT_PUBLIC_API_URL=http://localhost:3000
